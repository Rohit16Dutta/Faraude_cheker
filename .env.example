# Copy this file to .env and fill in the merchant logins for the couriers you use.
# Any courier left blank is skipped automatically — you don't need all of them.

PORT=3000

# Show fake courier numbers so you can try the site without any courier accounts.
DEMO_MODE=0

# Strongly recommended if the site is reachable from the internet: the checks run
# with YOUR courier accounts, so only people with this key should be able to use them.
ACCESS_KEY=

# How long to remember a phone number's result, and how many checks one visitor may run per minute.
CACHE_MINUTES=30
RATE_LIMIT_PER_MINUTE=30

# Steadfast merchant panel login (email + password)
STEADFAST_USER=
STEADFAST_PASSWORD=

# Pathao merchant panel login (email/phone + password)
PATHAO_USER=
PATHAO_PASSWORD=

# RedX merchant login (phone as 01XXXXXXXXX + password)
REDX_PHONE=
REDX_PASSWORD=

# Paperfly merchant login
PAPERFLY_USER=
PAPERFLY_PASSWORD=

# Carrybee merchant login (phone as 01XXXXXXXXX + password)
CARRYBEE_PHONE=
CARRYBEE_PASSWORD=
